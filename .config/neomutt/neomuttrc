# --- 1. Global Settings ---
set mbox_type = Maildir
set folder = "~/mail"
set spoolfile = "+posteo/INBOX"
set header_cache_backend = "lmdb"
set header_cache = "~/.cache/neomutt/hcache"
set editor = "nvim"
set mailcap_path = "~/.config/neomutt/mailcap"
set wait_key = no
source "~/.config/neomutt/colors.rc"
set move = no
set delete = ask-yes

# --- 2. Workflow & Sync ---
# Sync on startup (Background process)
push "<shell-escape>~/.config/neomutt/sync-mail.sh &<enter>"

# Disable automatic background checks to avoid conflicts with sync-mail.sh
set mail_check = 0
set beep_new = no

# --- 3. UI & Display ---
set sort = threads
set sort_aux = reverse-last-date

# Clean index: Index, Status, Date, Sender(20 chars), Subject
set index_format = "%4C %Z %{%d.%m.%Y} %?X?#& ? %-20.20L  %s"

# Minimalistic status bar
set status_format = " %f | %m Mails | %n Neu "

# Header cleaning for the Pager (Read view)
ignore *
unignore from: to: cc: subject: date:
hdr_order from: to: cc: subject: date:
set weed = yes

# --- 4. Account Switching (The Switch) ---
folder-hook '~/mail/posteo/.*' 'source ~/.config/neomutt/accounts/posteo'
folder-hook '~/mail/main/.*'   'source ~/.config/neomutt/accounts/main'
folder-hook '~/mail/spam/.*'   'source ~/.config/neomutt/accounts/spam'
folder-hook '~/mail/github/.*' 'source ~/.config/neomutt/accounts/github'

# --- 5. Keybindings & Macros ---

# Global Navigation
bind index,pager g noop
bind index,pager G bottom
bind index,pager q exit

# Index Movement
bind index j next-entry
bind index k previous-entry
bind index d delete-message
bind index u undelete-message
bind index gg first-entry

# Pager Movement (The Zen Scroll)
bind pager j next-line
bind pager k previous-line
bind pager <C-d> half-down
bind pager <C-u> half-up
bind pager <C-f> next-page
bind pager <C-b> previous-page
bind pager gg top
bind pager G bottom

# --- Search Navigation (Vim-like) ---
bind index n search-next
bind index N search-opposite

# --- Markierungs-Shortcuts ---
macro index R "<clear-flag>N<sync-mailbox>" "Mark as read"
macro index u "<set-flag>N<sync-mailbox>" "Mark as unread"

# Account Navigation
macro index 1 "<change-folder>+posteo/INBOX<enter>"
macro index 2 "<change-folder>+main/INBOX<enter>"
macro index 3 "<change-folder>+spam/INBOX<enter>"
macro index 4 "<change-folder>+github/INBOX<enter>"

# open mail in nvim
macro index,pager e "<pipe-message>nvim -<enter>" "Open in nvim"

# Sync Mails
macro index,pager S "<shell-escape>~/.config/neomutt/sync-mail.sh &<enter>" "Sync Mails"

# Folder Quick Switch
mailboxes +posteo/INBOX +posteo/Sent +main/INBOX +main/Gesendet +spam/INBOX +github/INBOX
macro index C "<change-folder>?<tab>" "Change to any mailbox"

# Url Viewer
macro index,pager \cb "<pipe-message>urlscan<enter>" "Call urlscan"


# --- 6. PGP Settings (Global defaults) ---
set pgp_use_gpg_agent = yes
set pgp_verify_sig = yes
set pgp_autosign = no
set pgp_autoencrypt = no

# --- 7. Formatting ---
auto_view text/html
alternative_order text/plain text/enriched text/html

# --- 8. Mailboxses ---
mailboxes +posteo/INBOX +posteo/Sent +main/INBOX +main/Gesendet +spam/INBOX +spam/Gesendet +github/INBOX +github/Gesendet

# --- 9. Exiting ---
macro index q "<sync-mailbox><shell-escape>mbsync -c ~/.config/isync/mbsyncrc -a && pkill -RTMIN+1 waybar<enter><quit>" "Sync and Quit"
