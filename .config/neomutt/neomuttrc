# --- 1. Basic Settings ---
set header_cache_backend = "lmdb"
set header_cache = "~/.cache/neomutt/hcache"
source "~/.config/neomutt/colors.rc"
set editor = "nvim"
set realname = "Franz Keilholz"
set folder = "~/mail"
set mbox_type = Maildir
set spoolfile = "+posteo/INBOX"
set mail_check = 60
set sendmail = "/usr/bin/msmtp"
set wait_key = no
set menu_scroll = yes
set tilde = yes
set beep_new = yes

# Signature configuration
set sig_dashes = yes

# --- 2. Mailbox Configuration ---
mailboxes +posteo/INBOX +main/INBOX +spam/INBOX +github/INBOX

# --- 3. Identity, Folder & Hook Logic ---
# These hooks handle the account context switching, including From, Record,
# Sendmail and PGP specific settings for each folder.

folder-hook '~/mail/posteo/*' ' \
    set from = "Franz Keilholz <franz.keilholz@posteo.de>"; \
    set record = "+posteo/Sent"; \
    set sendmail = "/usr/bin/msmtp -a posteo"; \
    set pgp_sign_as = "DB7201085C516B313F4B596F4AC6728E8FA2C883"; \
    set pgp_autosign = yes'; \
    set signature = "~/code/email_signatur/signatur_posteo.txt"'

folder-hook '~/mail/main/*'    ' \
    set from = "Franz Keilholz <franz@keilholz.biz>"; \
    set record = "+main/Sent"; \
    set sendmail = "/usr/bin/msmtp -a allinkl"; \
    set pgp_sign_as = "1F8A6479AAB3FD2A2895A50EA60EF9B74F4FF43E"; \
    set pgp_autosign = yes'; \
    set signature = "~/code/email_signatur/signatur_biz.txt"'

folder-hook '~/mail/spam/*'    ' \
    set from = "spam@keilholz.biz"; \
    set record = "+spam/Sent"; \
    set sendmail = "/usr/bin/msmtp -a allinkl"; \
    set pgp_autosign = no'

folder-hook '~/mail/github/*'  ' \
    set from = "github@keilholz.biz"; \
    set record = "+github/Sent"; \
    set sendmail = "/usr/bin/msmtp -a allinkl"; \
    set pgp_autosign = yes'

# Fallback to prevent PGP leakage when switching folders
send-hook . 'set pgp_autosign=no pgp_autoencrypt=no'

# --- 4. UI & Visuals ---
set sort_aux = last-date
set status_format = "-%r-NeoMutt: %f [Msgs:%m%?n? New:%n?%?o? Old:%o?%?d? Del:%d?%?F? Flag:%F?%?t? Tag:%t?%?p? Post:%p?%?b? Inc:%b?%?l? %l?]---(%s)-%>-(%P)---"

ignore *
unignore from: to: cc: subject: date:
hdr_order from: to: cc: subject: date:

# --- 5. Keybindings & Navigation ---
# Account switching
macro index 1 "<change-folder>+posteo/INBOX<enter>"
macro index 2 "<change-folder>+main/INBOX<enter>"
macro index 3 "<change-folder>+spam/INBOX<enter>"
macro index 4 "<change-folder>+github/INBOX<enter>"

# Sync trigger
macro index S "<shell-escape>bash -c 'setsid ~/.config/neomutt/sync-mail.sh >/dev/null 2>&1' &<enter>" "Sync Mail"

# --- PGP Settings ---
set pgp_use_gpg_agent = yes
set pgp_verify_sig = yes

# --- Vim-like Navigation ---
# Global movement
bind index j next-entry
bind index k previous-entry
bind pager j next-line
bind pager k previous-line

# Generic navigation
bind index,pager gg first-entry
bind index,pager G last-entry
bind index d delete-message
bind index u undelete-message
bind index o display-message
bind pager d half-down
bind pager u half-up
bind index,pager q exit

bind index,pager <F2> next-unread-mailbox
